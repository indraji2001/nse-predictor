// This is your Prisma schema file,
// learn more about it at the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------
//  Database — Turso (libSQL) for cloud / SQLite for local dev
// ------------------------------------------------------------------
//  We use the `sqlite` dialect because Turso is wire-compatible with
//  SQLite. The actual driver adapter (see src/lib/db.ts) decides at
//  runtime whether to use a local SQLite file or a remote Turso DB
//  based on which environment variables are set.
// ------------------------------------------------------------------
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Paper trade tracking — when user clicks "Track this trade" on a signal,
// the trade is saved here. Each night the update endpoint checks current
// price against entry, T1, T2, T3, and SL to mark the trade's status.
model PaperTrade {
  id            String   @id @default(cuid())
  symbol        String
  name          String
  sector        String
  timeframe     String   // BTST | SHORT_TERM | MIDTERM | LONG_TERM
  // Original trade plan (frozen at track time)
  entryPrice    Float
  stopLoss      Float
  target1       Float
  target2       Float
  target3       Float
  riskReward    Float
  holdingPeriod String
  confidence    Int
  // Live state
  status        String   @default("ACTIVE") // ACTIVE | HIT_T1 | HIT_T2 | HIT_T3 | STOPPED_OUT | TIME_EXIT | CLOSED
  currentPrice  Float?
  maxPrice      Float    @default(0) // highest since entry (for trailing)
  minPrice      Float    @default(0) // lowest since entry
  pnlPct        Float    @default(0) // (currentPrice - entryPrice) / entryPrice * 100
  hitTargets    String   @default("[]") // JSON array of targets hit, e.g. ["T1","T2"]
  // Metadata
  trackedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  closedAt      DateTime?
  notes         String?

  @@index([symbol])
  @@index([status])
  @@index([timeframe])
}

// ------------------------------------------------------------------
//  Upstox integration — single-row config table + instrument cache
// ------------------------------------------------------------------
model UpstoxConfig {
  id              Int       @id @default(1) // singleton row, always id=1
  apiKey          String
  apiSecret       String
  redirectUri     String
  accessToken     String?
  refreshToken    String?
  tokenExpiresAt  DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Cached NSE equity instrument keys downloaded from Upstox's master file.
// Refreshed on demand via /api/upstox/refresh-instruments.
model UpstoxInstrument {
  symbol        String   @id // NSE trading symbol (e.g. RELIANCE)
  instrumentKey String   // Upstox's key (e.g. NSE_EQ|INE002A01018)
  name          String?
  exchange      String   @default("NSE_EQ")
  isin          String?
  lotSize       Int?
  updatedAt     DateTime @updatedAt

  @@index([exchange])
}

// ------------------------------------------------------------------
//  Persistent Candle Cache
// ------------------------------------------------------------------
model StockCandle {
  id        Int      @id @default(autoincrement())
  symbol    String
  date      String   // ISO date string e.g. "2026-07-21" or "2026-07-21T09:15:00"
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  interval  String   // "day" | "5m" | "15m" | "1d"
  source    String   // "UPSTOX" | "YAHOO" | "NSE"
  createdAt DateTime @default(now())

  @@unique([symbol, date, interval, source])
  @@index([symbol, interval, source])
  @@index([date])
}

