{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "github": {
    "silent": false
  },
  "functions": {
    "src/app/api/predict/route.ts": { "maxDuration": 60 },
    "src/app/api/intraday-scan/route.ts": { "maxDuration": 60 },
    "src/app/api/papertrade/update/route.ts": { "maxDuration": 60 },
    "src/app/api/upstox/refresh-instruments/route.ts": { "maxDuration": 60 },
    "src/app/api/bhavcopy/backfill/route.ts": { "maxDuration": 60 },
