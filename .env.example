# ============================================================
#  NSE Predictor — Environment Configuration Template
# ============================================================
#
#  TWO MODES:
#
#  (A) LOCAL DEV — SQLite file (no cloud needed)
#      DATABASE_URL="file:./db/custom.db"
#
#  (B) PRODUCTION (Vercel + Cloudflare D1) — free forever, no quota
#      Set the 3 CLOUDFLARE_* vars below.
#      DATABASE_URL is not needed in production.
#
# ============================================================

# --- Mode A: Local SQLite (default for `npm run dev`) ----------------------
DATABASE_URL="file:./db/custom.db"

# --- Mode B: Cloudflare D1 (PRODUCTION — replaces Turso) ------------------
# Free tier: 50M row writes/day, 25M row reads/day, 10GB storage.
# Get these values from dash.cloudflare.com:
# CLOUDFLARE_ACCOUNT_ID      — shown in the URL bar of your Cloudflare dashboard
# CLOUDFLARE_D1_DATABASE_ID  — shown after creating a D1 database
# CLOUDFLARE_API_TOKEN       — API Token with Account > D1 > Edit permission
# CLOUDFLARE_ACCOUNT_ID="588616c794f2e656f0abc2f364a5db8b"
# CLOUDFLARE_D1_DATABASE_ID="158e64d6-170f-4781-af59-4cb5c23da9e5"
# CLOUDFLARE_API_TOKEN="cfut_xxxx..."

# --- DEPRECATED: Turso / libSQL (replaced by Cloudflare D1) ---------------
# DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# TURSO_AUTH_TOKEN="eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9..."

# ============================================================
#  Optional — Upstox integration (live intraday + historical candles)
#  These are entered via the in-app Settings dialog and stored in the
#  database, so you usually don't need to set them as env vars.
#  Provided here only for headless / scripted setup.
# ============================================================
# UPSTOX_API_KEY=""
# UPSTOX_API_SECRET=""
# UPSTOX_REDIRECT_URI="https://nse-predictor.vercel.app/api/upstox/callback"
