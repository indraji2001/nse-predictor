# ============================================================
#  NSE Predictor — Environment Configuration Template
# ============================================================
#
#  TWO MODES:
#
#  (A) LOCAL DEV — SQLite file
#      DATABASE_URL="file:./db/custom.db"
#      (Leave TURSO_AUTH_TOKEN unset.)
#
#  (B) PRODUCTION (Vercel + Turso) — managed cloud database
#      DATABASE_URL="libsql://<your-db-name>-<your-org>.turso.io"
#      TURSO_AUTH_TOKEN="<long random string from Turso dashboard>"
#
#  On Vercel, set BOTH variables in Project Settings → Environment Variables.
#  Never commit a real .env file with secrets — this .env.example is a template.
# ============================================================

# --- Mode A: Local SQLite (default for `npm run dev`) ----------------------
DATABASE_URL="file:./db/custom.db"

# --- Mode B: Turso (uncomment and fill for production) ---------------------
# DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# TURSO_AUTH_TOKEN="eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9..."

# ============================================================
#  Optional — Upstox integration (live intraday + historical candles)
#  These are entered via the in-app Settings dialog and stored in the
#  database, so you usually don't need to set them as env vars.
#  Provided here only for headless / scripted setup.
# ============================================================
# UPSTOX_API_KEY=""
# UPSTOX_API_SECRET=""
# UPSTOX_REDIRECT_URI="https://nse-predictor.vercel.app/api/upstox/callback"
