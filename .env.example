# ============================================================
#  NSE Predictor — Environment Configuration Template
# ============================================================
#
#  HOW TO USE:
#  1. Copy this file to ".env" (same folder)
#  2. Adjust the DATABASE_URL if needed (default is fine for local use)
#
#  The .env file is auto-generated by the start scripts on first
#  run if it doesn't exist, so you usually don't need to do anything.
# ============================================================

# SQLite database location (relative to project root)
# This creates db/custom.db on first run
DATABASE_URL="file:./db/custom.db"
